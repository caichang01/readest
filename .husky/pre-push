node-major=$(node -p "Number(process.versions.node.split('.')[0])")
if [ "$node-major" -lt 20 ]; then
  echo "Node.js 20 or newer is required for Readest pre-push checks (current: $(node -v))." >&2
  exit 1
fi

pnpm -C apps/readest-app format:check
pnpm -C apps/readest-app lint
pnpm -C apps/readest-app exec dotenv -e .env -e .env.test.local -- vitest run --maxWorkers=1
