# Fork Web/API image published by .github/workflows/fork-web-image.yml
READEST_IMAGE=ghcr.io/your-github-owner/readest:master
READEST_HTTP_PORT=3000

# Public HTTPS Supabase/Kong origin. SUPABASE_URL may instead be an internal
# origin when the Readest container can reach one directly.
SUPABASE_URL=https://supabase.example.com
SUPABASE_PUBLIC_URL=https://supabase.example.com
SUPABASE_ANON_KEY=replace-with-the-client-safe-anon-key

# Server only. Never add this value to NEXT_PUBLIC_ variables or native builds.
SUPABASE_SERVICE_ROLE_KEY=replace-with-the-service-role-key

# Public HTTPS origin of this Readest Web/API deployment.
API_BASE_URL=https://readest.example.com

# Optional Readest-managed object storage. It is separate from credentials that
# users enter in Settings > Integrations > S3.
OBJECT_STORAGE_TYPE=s3
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
S3_REGION=auto
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
TEMP_STORAGE_PUBLIC_BUCKET_NAME=

# Deployment-wide safeguards; 0 means unlimited.
STORAGE_LIMIT_BYTES=0
TRANSLATION_DAILY_LIMIT=0
